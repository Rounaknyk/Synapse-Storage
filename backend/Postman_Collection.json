          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"financial reports\",\n  \"top_k\": 3\n}"
        },
        "url": {
          "raw": "http://localhost:8000/search",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["search"]
        }
