        "url": {
          "raw": "http://localhost:8000/upload",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["upload"]
        }
      }
    },
    {
      "name": "Search Documents",
      "request": {
        "method": "POST",
